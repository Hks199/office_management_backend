NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
MONGODB_URI=mongodb://127.0.0.1:27017/sunvika?replicaSet=rs0&directConnection=true
MONGODB_MAX_POOL_SIZE=20
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_WAIT_QUEUE_TIMEOUT_MS=2000
SLOW_QUERY_MS=1000
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY_HOPS=0
BODY_LIMIT_BYTES=102400
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
# Required mongo in production; memory is for a single development/test process.
RATE_LIMIT_STORE=memory
DOCS_ENABLED=true
SHUTDOWN_TIMEOUT_MS=10000
# Required together for Phase 4 photos and Phase 5 CSV import/export; optional for unrelated APIs.
# Private encrypted versioned bucket with all public access blocks; use IAM roles.
# AWS_REGION=ap-south-1
# S3_BUCKET=sunvika-private-files
# The application uses AWS_REGION and S3_BUCKET, not AWS_S3_REGION/AWS_S3_BUCKET.
# Local development alternative to an IAM role/profile. Keep credentials backend-only.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# Enable in-process customer import validation/commit and lead export processing.
# Leave disabled when these jobs are handled by a separate scheduler.
COMMERCIAL_JOBS_ENABLED=false
COMMERCIAL_JOBS_INTERVAL_MS=5000
# REDIS_URL=redis://127.0.0.1:6379
# Required independent secrets. Generate each with node:crypto; see ENVIRONMENT_SETUP.md.
JWT_SECRET=
TOKEN_ENCRYPTION_KEY=
JWT_ISSUER=sunvika-office-api
JWT_AUDIENCE=sunvika-office-web
ACCESS_TTL_SECONDS=600
REFRESH_TTL_DAYS=7
REFRESH_ABSOLUTE_DAYS=30
CREDENTIAL_UI_ORIGIN=http://localhost:5173
# Starts automatically with the API when SMTP is configured.
CREDENTIAL_DELIVERY_ENABLED=true
CREDENTIAL_DELIVERY_INTERVAL_MS=5000
# Required to deliver invitations/resets. Missing SMTP produces a startup warning.
# SMTP_HOST=smtp.example.invalid
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=office@example.invalid
# BOOTSTRAP_EMPLOYEE_CODE=SV-MD-001
# BOOTSTRAP_FIRST_NAME=
# BOOTSTRAP_LAST_NAME=
# BOOTSTRAP_EMAIL=
# BOOTSTRAP_MOBILE_NUMBER=

# INVITATION_EMPLOYEE_CODE=SV-MD-001

# Optional Phase 3 vetted UTF-8 JSON reference data (no built-in geography).
# LOCATION_SEED_FILE=D:/secure/sunvika-locations.json
