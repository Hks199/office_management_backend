# Docker Compose interpolation file, not a shell script. Never commit real values.
# Installed at /opt/sunvika-office/shared/backend.env with root:deploygroup 0640.
# Quote values containing # or $ with single quotes; percent-encode URI passwords.
MONGODB_URI=
JWT_SECRET=
TOKEN_ENCRYPTION_KEY=
CORS_ORIGINS=https://app.example.com
CREDENTIAL_UI_ORIGIN=https://app.example.com
AWS_REGION=ap-south-1
S3_BUCKET=

# One host Nginx proxy; API stays bound to host loopback through production Compose.
TRUST_PROXY_HOPS=1
LOG_LEVEL=info
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
MONGODB_MAX_POOL_SIZE=20
MONGODB_WAIT_QUEUE_TIMEOUT_MS=2000
SLOW_QUERY_MS=1000

# Invites/password resets use the API's automatic worker when SMTP is configured.
CREDENTIAL_DELIVERY_ENABLED=true
CREDENTIAL_DELIVERY_INTERVAL_MS=5000
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
