{
  "name": "sunvika-office-backend",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "description": "Sunvika office management API - scoped organization, commercial activity, verified targets and dashboards",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --enable-source-maps dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "check:release": "npm run lint && npm run typecheck && npm run test:coverage && npm run build && npm run audit:production && npm run validate:production-compose",
    "audit:production": "npm audit --omit=dev",
    "bootstrap:md": "tsx src/scripts/bootstrap-md.ts",
    "seed:permissions": "tsx src/scripts/seed-permissions.ts",
    "seed:roles": "tsx src/scripts/seed-roles.ts",
    "align:bdo-permissions": "tsx src/scripts/align-bdo-permissions.ts",
    "repair:md-creation-policies": "tsx src/scripts/repair-md-creation-policies.ts",
    "db:indexes:identity": "tsx src/scripts/identity-indexes.ts",
    "deliver:credentials": "tsx src/scripts/deliver-credentials.ts",
    "invite:reissue": "tsx src/scripts/reissue-invitation.ts",
    "db:indexes:organization": "tsx src/scripts/organization-indexes.ts",
    "db:indexes:reporting-managers": "tsx src/scripts/reporting-manager-index.ts",
    "seed:locations": "tsx src/scripts/seed-locations.ts",
    "db:indexes:attendance": "tsx src/scripts/attendance-indexes.ts",
    "cleanup:orphan-photos": "tsx src/scripts/cleanup-orphan-photos.ts",
    "db:indexes:commercial": "tsx src/scripts/commercial-indexes.ts",
    "db:backfill:customers": "tsx src/scripts/backfill-customers.ts",
    "jobs:commercial": "tsx src/scripts/process-commercial-jobs.ts",
    "enable:commercial-capabilities": "tsx src/scripts/enable-commercial-capabilities.ts",
    "enable:lead-routing": "tsx src/scripts/enable-lead-routing.ts",
    "db:indexes:reports": "tsx src/scripts/report-indexes.ts",
    "db:indexes:targets": "tsx src/scripts/target-indexes.ts",
    "db:indexes:dashboards": "tsx src/scripts/dashboard-indexes.ts",
    "jobs:dashboards": "tsx src/scripts/process-dashboard-jobs.ts",
    "db:indexes:production": "tsx src/scripts/production-indexes.ts",
    "ops:preflight": "tsx src/scripts/production-preflight.ts",
    "test:container": "tsx tools/container-smoke.ts",
    "test:load": "tsx tools/load-smoke.ts",
    "validate:production-compose": "tsx tools/container-smoke.ts --config-only"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-presigned-post": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.3",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "joi": "^18.3.0",
    "jose": "^6.2.12",
    "mongoose": "^9.11.2",
    "nodemailer": "^10.1.2",
    "openapi-types": "^12.1.3",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@eslint/js": "^10.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "jiti": "^2.7.0",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
